<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#102A27" TextElement.FontFamily="Microsoft YaHei UI" TextElement.Foreground="#202F2C">
  <Grid.Resources>
    <Style TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="12,7"/><Setter Property="Foreground" Value="#205A50"/>
      <Setter Property="Background" Value="#ECF3F0"/><Setter Property="BorderBrush" Value="#CEDCD5"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Skin" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" /></Border><ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Skin" Property="Opacity" Value=".82"/></Trigger>
        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Skin" Property="BorderBrush" Value="#10766B"/><Setter TargetName="Skin" Property="BorderThickness" Value="2"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Skin" Property="Opacity" Value=".50"/></Trigger>
      </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#B5C6BE"/><Setter Property="Foreground" Value="#1D302A"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="14"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="#FFFFFF"/><Setter Property="BorderBrush" Value="#B5C6BE"/><Setter Property="Padding" Value="10,6"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="34"/><Setter Property="FontSize" Value="14"/></Style>
    <Style x:Key="Field" TargetType="TextBlock"><Setter Property="Margin" Value="0,10,0,5"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#41564D"/></Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#126B57"/><Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="MinHeight" Value="40"/></Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="400" MinWidth="355"/></Grid.ColumnDefinitions>
  <Image x:Name="Artwork" Grid.ColumnSpan="2" Stretch="UniformToFill" IsHitTestVisible="False" AutomationProperties.Name="绿荫小憩"/>
  <Grid IsHitTestVisible="False"><Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#2807110F" Offset="0"/><GradientStop Color="#0007110F" Offset=".23"/><GradientStop Color="#0007110F" Offset=".73"/><GradientStop Color="#A914261C" Offset="1"/></LinearGradientBrush></Grid.Background>
    <StackPanel Margin="28,20,0,24" VerticalAlignment="Bottom" HorizontalAlignment="Left"><TextBlock Text="OF_SF" Foreground="White" FontFamily="Segoe UI" FontSize="40" FontWeight="Bold"/></StackPanel>
  </Grid>
  <Border Grid.Column="1" Background="#FBFCF9" Margin="0">
    <Grid Margin="26,17,26,15"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,8">
        <TextBlock Text="OF_SF" FontFamily="Segoe UI" FontSize="13" FontWeight="Bold" Foreground="#467260" VerticalAlignment="Center"/>
        <Button x:Name="Options" DockPanel.Dock="Right" Content="设置" Padding="10,4" FontSize="12" AutomationProperties.Name="游戏和连接设置"/>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" PanningMode="VerticalOnly">
        <Grid Margin="0,2,2,5">
          <StackPanel x:Name="AccountPanel">
            <TextBlock x:Name="Heading" Text="账号登录" FontSize="28" FontWeight="SemiBold" Margin="0,3,0,10"/>
            <UniformGrid Rows="1" Background="#E6EEE8" Margin="0,0,0,6"><Button x:Name="LoginTab" Content="登录" FontWeight="SemiBold"/><Button x:Name="RegisterTab" Content="注册" FontWeight="SemiBold"/></UniformGrid>
            <TextBlock Text="服务器地址" Style="{StaticResource Field}"/>
            <ComboBox x:Name="Endpoint" IsEditable="True" IsTextSearchEnabled="False" FontSize="14" Height="35" VerticalContentAlignment="Center" Padding="8,4" AutomationProperties.Name="服务器 IP 或域名"/>
            <TextBlock Text="输入 IP 或域名，可加端口（默认 18443）。" Margin="0,4,0,0" FontSize="11" Foreground="#53665B"/>
            <TextBlock Text="账号" Style="{StaticResource Field}"/>
            <DockPanel><Button x:Name="CheckAccount" DockPanel.Dock="Right" Margin="6,0,0,0" Content="检查账号" Padding="9,4"/><TextBox x:Name="Username" MaxLength="64" AutomationProperties.Name="区服账号"/></DockPanel>
            <TextBlock Text="密码" Style="{StaticResource Field}"/>
            <PasswordBox x:Name="Secret" MaxLength="128" AutomationProperties.Name="区服密码"/>
            <StackPanel x:Name="NamePanel" Visibility="Collapsed"><TextBlock Text="角色名（可选，可在游戏内设置）" Style="{StaticResource Field}"/><TextBox x:Name="Nickname" MaxLength="32" AutomationProperties.Name="注册角色名"/></StackPanel>
            <StackPanel x:Name="CaptchaPanel" Visibility="Collapsed"><TextBlock Text="图片验证码" Style="{StaticResource Field}"/>
              <DockPanel><Image x:Name="CaptchaImage" DockPanel.Dock="Left" Width="114" Height="36" Stretch="Uniform" Margin="0,0,4,0"/><Button x:Name="RefreshCaptcha" DockPanel.Dock="Right" Content="换一张" Margin="5,0,0,0" Padding="7,3"/><TextBox x:Name="Answer" AutomationProperties.Name="验证码答案" MaxLength="12"/></DockPanel>
            </StackPanel>
            <Button x:Name="Primary" Content="登录并进入游戏" Style="{StaticResource Primary}" Margin="0,16,0,0"/>
            <Button x:Name="ImportSave" Content="继承已有存档" Margin="0,6,0,1" MinHeight="32"/>
          </StackPanel>
          <StackPanel x:Name="SettingsPanel" Visibility="Collapsed">
            <TextBlock Text="登陆器设置" FontSize="26" FontWeight="SemiBold" Margin="0,3,0,5"/>
            <TextBlock Text="原游戏目录" Style="{StaticResource Field}"/><DockPanel><Button x:Name="SourceBrowse" DockPanel.Dock="Right" Content="浏览" Margin="5,0,0,0"/><TextBox x:Name="Source" AutomationProperties.Name="TapTap 游戏目录"/></DockPanel>
            <TextBlock Text="选择含 launcher.exe 的 TapTap 安装目录。" TextWrapping="Wrap" Margin="0,4" Foreground="#53665B" FontSize="11"/>
            <TextBlock Text="工作目录（可选）" Style="{StaticResource Field}"/><DockPanel><Button x:Name="BaseBrowse" DockPanel.Dock="Right" Content="浏览" Margin="5,0,0,0"/><TextBox x:Name="Work" AutomationProperties.Name="工作目录"/></DockPanel>
            <TextBlock Text="与原游戏同盘时可留空，资源通过硬链接复用。" TextWrapping="Wrap" Margin="0,4" Foreground="#53665B" FontSize="11"/>
            <TextBlock Text="当前区服证书" Style="{StaticResource Field}"/><TextBlock x:Name="TrustLabel" Foreground="#40594B" TextWrapping="Wrap" Margin="0,2,0,6"/>
            <WrapPanel><Button x:Name="SelectCa" Content="选择 CA 文件" Margin="0,0,5,4"/><Button x:Name="Reverify" Content="重新核对证书" Margin="0,0,0,4"/></WrapPanel>
            <Button x:Name="Test" Content="测试区服连接" Margin="0,9,0,4"/>
            <Button x:Name="AcceptSettings" Content="保存并返回" Style="{StaticResource Primary}" Margin="0,9,0,5"/>
            <Button x:Name="ClearWork" Content="清除本机游戏副本" HorizontalAlignment="Left" Background="Transparent" Foreground="#854B43" Padding="0,7"/>
          </StackPanel>
        </Grid>
      </ScrollViewer>
      <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#D5DED5" Padding="0,8,0,0" Margin="0,4,0,0"><TextBlock x:Name="Status" Text="退出后可从 TapTap 进入官服。" TextWrapping="Wrap" Foreground="#4F6458" FontSize="12" AutomationProperties.LiveSetting="Polite"/></Border>
    </Grid>
  </Border>
</Grid>
